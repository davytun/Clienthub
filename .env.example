##############################################################################
#  CLIENTHUB — Environment Configuration
#  Copy this file to .env and fill in every value marked with <...>
#  Lines starting with # are explanatory comments — safe to leave as-is
##############################################################################

# ─── Application ─────────────────────────────────────────────────────────────

APP_NAME="Clienthub"
APP_ENV=production          # Change to "local" for development
APP_KEY=                    # Run: php artisan key:generate
APP_DEBUG=false             # NEVER set to true in production
APP_URL=https://<yourdomain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ─── Security ────────────────────────────────────────────────────────────────

# Number of bcrypt rounds for password hashing (12 is the Laravel default;
# increase to 13–14 on powerful servers for stronger hashing)
BCRYPT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error             # Use "debug" only in local development

# ─── Database ────────────────────────────────────────────────────────────────
# Production: use MySQL or PostgreSQL — never SQLite in production.
# Development only: DB_CONNECTION=sqlite (no other DB vars needed)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1           # Usually 127.0.0.1 for same-server MySQL
DB_PORT=3306
DB_DATABASE=<clienthub>     # Name of your MySQL database
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>

# ─── Cache ───────────────────────────────────────────────────────────────────
# "database" works out of the box. Switch to "redis" for better performance.

CACHE_STORE=database

# ─── Sessions ────────────────────────────────────────────────────────────────
# SESSION_SECURE_COOKIE requires your site to be served over HTTPS.
# SESSION_ENCRYPT encrypts all session data at rest.

SESSION_DRIVER=database
SESSION_LIFETIME=120        # Minutes of inactivity before session expires
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null         # Set to .yourdomain.com to share across subdomains
SESSION_SECURE_COOKIE=true  # Requires HTTPS — set false for local http dev
SESSION_SAME_SITE=lax

# ─── Queue ───────────────────────────────────────────────────────────────────
# Clienthub queues all outgoing mail. You MUST run a queue worker in
# production or emails will never be sent.
#
# Start worker:     php artisan queue:work --tries=3 --timeout=60
# With Supervisor:  see DEPLOYMENT.md for the supervisor config block

QUEUE_CONNECTION=database

# ─── File Storage ────────────────────────────────────────────────────────────
# "local" stores files in storage/app (private, never public-accessible).
# For multi-server / cloud deployments switch to "s3" and fill AWS vars below.

FILESYSTEM_DISK=local

# S3 / R2 / DigitalOcean Spaces (only needed when FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=               # For non-AWS S3-compatible (R2, Spaces, etc.)
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Mail ────────────────────────────────────────────────────────────────────
# Clienthub sends: client invitations, staff invitations, invoice emails,
# message notifications.
#
# ── Mailtrap (for testing — see https://mailtrap.io → Inboxes → SMTP) ───────
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<mailtrap_username>
# MAIL_PASSWORD=<mailtrap_password>
# MAIL_SCHEME=null
#
# ── Production (your hosting provider's SMTP) ────────────────────────────────
# Replace the values below with the credentials from your host's mail panel.
# Common ports: 587 (STARTTLS), 465 (SSL/TLS), 25 (plain — avoid)

MAIL_MAILER=smtp
MAIL_HOST=<smtp.yourhost.com>
MAIL_PORT=587
MAIL_USERNAME=<mail_username>
MAIL_PASSWORD=<mail_password>
MAIL_SCHEME=null            # "tls" for port 465, null for port 587 STARTTLS
MAIL_FROM_ADDRESS="no-reply@<yourdomain.com>"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Redis (optional — improves queue and cache performance) ─────────────────
# Install: apt install redis-server
# Then set CACHE_STORE=redis and QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
